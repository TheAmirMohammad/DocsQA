# Environment Configuration for DocsQA

PROJECT_NAME=DocsQA
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (PostgreSQL 17 with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docsqa

# Redis Cache and Job Queue
REDIS_URL=redis://localhost:6379/0

# Model Provider: stub (deterministic offline), openai (hosted API), ollama (local)
MODEL_PROVIDER=stub

# Hosted OpenAI Configuration (Used when MODEL_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Ollama Configuration (Used when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# Embedding Specification & Versioning
# Must match the model: stub=384, nomic-embed-text=768, text-embedding-3-small=any (sent as `dimensions`).
# Use a fresh database (alembic creates vector(EMBEDDING_DIMENSION)) when switching models.
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL_VERSION=stub-v1.0

# Retrieval & Fusion Parameters
RETRIEVAL_TOP_K=5
RETRIEVAL_VECTOR_CANDIDATES=20
RETRIEVAL_FTS_CANDIDATES=20
RRF_K=60
VECTOR_MIN_SIMILARITY=0.15

# Semantic Cache TTL (seconds)
CACHE_TTL_SECONDS=86400

# Documentation Ingestion Directory
SAMPLE_DOCS_PATH=./sample_docs/fastapi_tutorial
# POST /ingest only accepts directories under this root
DOCS_ROOT=./sample_docs
