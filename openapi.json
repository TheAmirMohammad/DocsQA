{
  "openapi": "3.1.0",
  "info": {
    "title": "DocsQA",
    "description": "Production-grade question-answering API over technical documentation featuring hybrid retrieval (pgvector + full-text search with Reciprocal Rank Fusion), semantic Redis caching with index-version invalidation, answer refusal, and automated regression evaluation harness.",
    "version": "1.0.0"
  },
  "paths": {
    "/ask": {
      "post": {
        "summary": "Ask a question against documentation",
        "description": "Answers questions using hybrid retrieval (pgvector + full-text search) merged with RRF.\nAnswers include inline citations. When retrieved evidence is weak, the API refuses instead of hallucinating.",
        "operationId": "ask_question_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ingest": {
      "post": {
        "summary": "Trigger incremental ingestion",
        "description": "Queue or run incremental documentation ingestion with content-hash checks.",
        "operationId": "trigger_ingestion_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "400": {
            "description": "source_path is not a directory under DOCS_ROOT"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "summary": "Get ingestion job status",
        "description": "Retrieve status, statistics, and errors for a specific ingestion job.",
        "operationId": "get_job_status_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents": {
      "get": {
        "summary": "List indexed documentation files",
        "description": "List all documents currently in the index along with chunk counts and content hashes.",
        "operationId": "list_documents_documents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/evals/latest": {
      "get": {
        "summary": "Get most recent evaluation harness report",
        "description": "Returns the latest evaluation report comparing Vector, FTS, and Hybrid RRF.",
        "operationId": "get_latest_evals_evals_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Latest Evals Evals Latest Get"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Service health check",
        "description": "Probe PostgreSQL, Redis, and global index version.",
        "operationId": "health_check_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus metrics scrape endpoint",
        "description": "Export Prometheus format metrics.",
        "operationId": "prometheus_metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "minLength": 3,
            "title": "Question",
            "description": "The technical question to answer from documentation."
          },
          "mode": {
            "type": "string",
            "enum": [
              "hybrid",
              "vector",
              "fts",
              "hybrid_weighted"
            ],
            "title": "Mode",
            "description": "Retrieval strategy: 'hybrid' (RRF), 'hybrid_weighted' (weighted RRF), 'vector' (pgvector), or 'fts' (full-text search).",
            "default": "hybrid"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "Maximum number of context chunks to retrieve.",
            "default": 5
          },
          "rerank": {
            "type": "boolean",
            "title": "Rerank",
            "description": "Whether to apply post-retrieval cross-encoder / semantic reranking.",
            "default": false
          },
          "bypass_cache": {
            "type": "boolean",
            "title": "Bypass Cache",
            "description": "Whether to bypass semantic response cache.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationSchema"
            },
            "type": "array",
            "title": "Citations"
          },
          "refused": {
            "type": "boolean",
            "title": "Refused"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached"
          },
          "index_version": {
            "type": "integer",
            "title": "Index Version"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          },
          "retrieval_mode": {
            "type": "string",
            "title": "Retrieval Mode"
          },
          "debug": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Debug"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "citations",
          "refused",
          "cached",
          "index_version",
          "latency_ms",
          "retrieval_mode"
        ],
        "title": "AskResponse"
      },
      "CitationSchema": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "heading": {
            "type": "string",
            "title": "Heading"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          }
        },
        "type": "object",
        "required": [
          "index",
          "source_url",
          "heading",
          "chunk_id"
        ],
        "title": "CitationSchema"
      },
      "DocumentItemSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source_path": {
            "type": "string",
            "title": "Source Path"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash"
          },
          "chunks_count": {
            "type": "integer",
            "title": "Chunks Count"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "source_path",
          "title",
          "content_hash",
          "chunks_count",
          "updated_at"
        ],
        "title": "DocumentItemSchema"
      },
      "DocumentsResponse": {
        "properties": {
          "total_documents": {
            "type": "integer",
            "title": "Total Documents"
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentItemSchema"
            },
            "type": "array",
            "title": "Documents"
          }
        },
        "type": "object",
        "required": [
          "total_documents",
          "total_chunks",
          "documents"
        ],
        "title": "DocumentsResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "redis": {
            "type": "string",
            "title": "Redis"
          },
          "index_version": {
            "type": "integer",
            "title": "Index Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "redis",
          "index_version",
          "environment"
        ],
        "title": "HealthResponse"
      },
      "IngestRequest": {
        "properties": {
          "source_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Path",
            "description": "Relative or absolute path to docs directory. Defaults to configured SAMPLE_DOCS_PATH."
          },
          "git_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Git Url",
            "description": "Optional Git repository URL to clone and ingest (HTTP/HTTPS or SSH)."
          },
          "branch": {
            "type": "string",
            "title": "Branch",
            "description": "Branch name when cloning git repository.",
            "default": "main"
          },
          "subpath": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subpath",
            "description": "Optional subfolder path inside cloned git repository to ingest."
          }
        },
        "type": "object",
        "title": "IngestRequest"
      },
      "IngestResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "message"
        ],
        "title": "IngestResponse"
      },
      "JobStatusResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source_path": {
            "type": "string",
            "title": "Source Path"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "docs_scanned": {
            "type": "integer",
            "title": "Docs Scanned"
          },
          "docs_modified": {
            "type": "integer",
            "title": "Docs Modified"
          },
          "chunks_created": {
            "type": "integer",
            "title": "Chunks Created"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "source_path",
          "status",
          "docs_scanned",
          "docs_modified",
          "chunks_created",
          "created_at"
        ],
        "title": "JobStatusResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}